# RhinoView local settings. Copy this file to .env and edit the paths.

RHINO_DATA_DIR=D:\rhino\data
RHINO_DEFAULT_PROJECT=TPRO
RHINO_HOST=0.0.0.0
RHINO_PORT=8000

# Optional overrides. When RHINO_DATABASE_URL is empty the app uses
# <RHINO_DATA_DIR>\app.db (SQLite).
# RHINO_DATABASE_URL=sqlite:///D:/rhino/data/app.db

# The converter runs in the same Python environment as the API by default.
# RHINO_CONVERTER_PYTHON=D:\rhino\app\.venv\Scripts\python.exe
# RHINO_CONVERTER_SCRIPT=D:\rhino\app\services\converter-3dm\convert.py

# Extra dev origins for Vite (comma separated). Same-origin production needs none.
RHINO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
